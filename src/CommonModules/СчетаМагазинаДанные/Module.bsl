// Разбирает тело запроса создания по схеме объекта. Мета уже сверена РазобратьИмяТипа.
// Возвращает структуру header, tables с точными типами 1С. Ошибки добавляет в Ошибки; запись объекта не выполняет.
Функция Подготовить(Мета, Данные, Ошибки) Экспорт
	Результат = Новый Структура("header,tables", Новый Соответствие, Новый Соответствие);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, Неопределено, "Тело должно быть объектом с type, header и tables");
		Возврат Результат;
	КонецЕсли;
	Схема = СчетаМагазинаМетаданные.СхемаОбъекта(Мета);
	ЭтоДокумент = Метаданные.Документы.Найти(Мета.Имя) = Мета;
	// Вид создаваемого справочника задаёт ЭтоГруппа в шапке запроса; её тип проверяет ПодготовитьПоля.
	ЭтоГруппа = Ложь;
	Если Не ЭтоДокумент И ТипЗнч(Данные.Получить("header")) = Тип("Соответствие") Тогда
		ЭтоГруппа = Данные.Получить("header").Получить("ЭтоГруппа") = Истина;
	КонецЕсли;
	Для Каждого Элемент Из Данные Цикл
		Если Элемент.Ключ <> "type" И Элемент.Ключ <> "header" И Элемент.Ключ <> "tables" Тогда
			Ошибка(Ошибки, Элемент.Ключ, "Неизвестное поле");
		КонецЕсли;
	КонецЦикла;
	Если Данные.Получить("type") <> Схема.type Тогда
		Ошибка(Ошибки, "type", "Тип в теле запроса должен совпадать с типом объекта");
	КонецЕсли;
	Заголовок = Данные.Получить("header");
	Если ТипЗнч(Заголовок) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, "header", "Требуется объект header");
	Иначе
		ПодготовитьПоля(Заголовок, Схема.fields, Мета, Неопределено, "header", Результат.header, Ошибки, ЭтоГруппа);
		// Дату документа проверяет сам сервис, остальную обязательность — штатная проверка заполнения.
		Если ЭтоДокумент И Не ЕстьОшибкаПути(Ошибки, "header.Дата")
			И Не ЗначениеЗаполнено(Результат.header.Получить("Дата")) Тогда
			Ошибка(Ошибки, "header.Дата", "Дата обязательна");
		КонецЕсли;
	КонецЕсли;
	Таблицы = Данные.Получить("tables");
	Если ТипЗнч(Таблицы) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, "tables", "Требуется объект tables");
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Таблицы Цикл
		Путь = "tables." + Элемент.Ключ;
		Описание = НайтиОписание(Схема.tables, Элемент.Ключ);
		Если Описание = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестная табличная часть");
			Продолжить;
		КонецЕсли;
		Если Не Описание.writable Тогда
			Ошибка(Ошибки, Путь, Описание.reason);
			Продолжить;
		КонецЕсли;
		МетаТаблицы = Мета.ТабличныеЧасти[Элемент.Ключ];
		Если Не ПрименяетсяКОбъекту(МетаТаблицы, Мета, ЭтоГруппа) Тогда
			Ошибка(Ошибки, Путь, ТекстНеПрименяется(ЭтоГруппа, "Табличная часть"));
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент.Значение) <> Тип("Массив") Тогда
			Ошибка(Ошибки, Путь, "Требуется массив строк");
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		Индекс = 0;
		Для Каждого СтрокаДанных Из Элемент.Значение Цикл
			ПутьСтроки = Путь + "[" + Формат(Индекс, "ЧГ=0") + "]";
			СтрокаТипизированная = Новый Соответствие;
			Если ТипЗнч(СтрокаДанных) <> Тип("Соответствие") Тогда
				Ошибка(Ошибки, ПутьСтроки, "Требуется объект строки");
			Иначе
				ПодготовитьПоля(СтрокаДанных, Описание.fields, Мета, МетаТаблицы, ПутьСтроки,
					СтрокаТипизированная, Ошибки, ЭтоГруппа);
			КонецЕсли;
			Строки.Добавить(СтрокаТипизированная);
			Индекс = Индекс + 1;
		КонецЦикла;
		Результат.tables.Вставить(Элемент.Ключ, Строки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЕстьОшибкаПути(Ошибки, Путь)
	Для Каждого ЭлементОшибки Из Ошибки Цикл
		Если ЭлементОшибки.path = Путь Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Применяется ли реквизит или табличная часть справочника к объекту: к группе, к элементу или к обоим
// (свойство платформы Использование). Для документа и для метаданных без такого свойства — Истина.
// ЭлементМета — реквизит или табличная часть, Мета — справочник или документ; ЭтоГруппа — вид объекта.
Функция ПрименяетсяКОбъекту(ЭлементМета, Мета, ЭтоГруппа) Экспорт
	Если Метаданные.Справочники.Найти(Мета.Имя) <> Мета Или ЭлементМета = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Использование = ЭлементМета.Использование;
	Виды = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита;
	Если Использование = Виды.ДляГруппыИЭлемента Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Использование = ?(ЭтоГруппа, Виды.ДляГруппы, Виды.ДляЭлемента);
КонецФункции

// Поле шапки применяется к объекту: прикладной реквизит проверяется по Использованию,
// стандартные и общие реквизиты такого свойства не имеют.
Функция ПолеШапкиПрименяется(Мета, Имя, ЭтоГруппа) Экспорт
	Возврат ПрименяетсяКОбъекту(Мета.Реквизиты.Найти(Имя), Мета, ЭтоГруппа);
КонецФункции

// Объект справочника с группами и элементов, если это группа. Документ и справочник без групп — Ложь.
Функция ЭтоГруппаОбъекта(Объект, Мета) Экспорт
	Если Метаданные.Справочники.Найти(Мета.Имя) <> Мета Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не Мета.Иерархический Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Мета.ВидИерархии <> Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Объект.ЭтоГруппа = Истина;
КонецФункции

Функция ТекстНеПрименяется(ЭтоГруппа, Что)
	Возврат Что + " не применяется к " + ?(ЭтоГруппа, "группе", "элементу");
КонецФункции

// МетаТаблицы — Неопределено для шапки. Значения поля преобразуются по типам этого поля в метаданных.
// ЭтоГруппа — вид создаваемого объекта; поле, не применимое к нему, отклоняется.
Процедура ПодготовитьПоля(Вход, Поля, Мета, МетаТаблицы, Префикс, Выход, Ошибки, ЭтоГруппа)
	Для Каждого Элемент Из Вход Цикл
		Путь = Префикс + "." + Элемент.Ключ;
		Поле = НайтиОписание(Поля, Элемент.Ключ);
		Если Поле = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестное поле");
			Продолжить;
		КонецЕсли;
		Если Не Поле.writable Тогда
			Ошибка(Ошибки, Путь, Поле.reason);
			Продолжить;
		КонецЕсли;
		Если МетаТаблицы = Неопределено И Не ПолеШапкиПрименяется(Мета, Элемент.Ключ, ЭтоГруппа) Тогда
			Ошибка(Ошибки, Путь, ТекстНеПрименяется(ЭтоГруппа, "Поле"));
			Продолжить;
		КонецЕсли;
		Роль = "";
		Если МетаТаблицы = Неопределено Тогда
			ТипыПоля = ТипыПоляОбъекта(Мета, Элемент.Ключ);
			Роль = РольПоля(Мета, Элемент.Ключ);
		Иначе
			ТипыПоля = ТипыПоляТаблицы(МетаТаблицы, Элемент.Ключ);
		КонецЕсли;
		ОшибокДо = Ошибки.Количество();
		Значение = Преобразовать(Элемент.Значение, Поле, ТипыПоля, Путь, Ошибки, Мета, Роль);
		Если ОшибокДо = Ошибки.Количество() Тогда
			Выход.Вставить(Элемент.Ключ, Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Родитель и Владелец справочника — стандартные реквизиты со своими правилами ссылки.
Функция РольПоля(Мета, Имя)
	Если Метаданные.Справочники.Найти(Мета.Имя) <> Мета Тогда
		Возврат "";
	КонецЕсли;
	Если Имя = "Родитель" И Мета.Иерархический Тогда
		Возврат "Родитель";
	ИначеЕсли Имя = "Владелец" И Мета.Владельцы.Количество() > 0 Тогда
		Возврат "Владелец";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция Преобразовать(Вход, Поле, ТипыПоля, Путь, Ошибки, Мета, Роль)
	Если Вход = Неопределено Тогда
		Возврат ТипыПоля.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Типы = ТипыПоля.Типы();
	ИндексТипа = 0;
	Если Поле.types.Количество() > 1 Тогда
		Если ТипЗнч(Вход) <> Тип("Соответствие") Тогда
			Ошибка(Ошибки, Путь, "Составной тип требует объект type и value");
			Возврат Неопределено;
		КонецЕсли;
		ЕстьЗначение = Ложь;
		Для Каждого Ключ Из Вход Цикл
			Если Ключ.Ключ = "value" Тогда
				ЕстьЗначение = Истина;
			ИначеЕсли Ключ.Ключ <> "type" Тогда
				Ошибка(Ошибки, Путь, "Неизвестное поле типизированного значения");
			КонецЕсли;
		КонецЦикла;
		ИндексТипа = -1;
		Для Индекс = 0 По Поле.types.Количество() - 1 Цикл
			Если Поле.types[Индекс].name = Вход.Получить("type") Тогда
				ИндексТипа = Индекс;
			КонецЕсли;
		КонецЦикла;
		Если ИндексТипа = -1 Или Не ЕстьЗначение Тогда
			Ошибка(Ошибки, Путь, "Недопустимый type либо отсутствует value");
			Возврат Неопределено;
		КонецЕсли;
		Вход = Вход.Получить("value");
	КонецЕсли;
	Описание = Поле.types[ИндексТипа];
	Если Вход = Неопределено Тогда
		ОдинТип = Новый Массив;
		ОдинТип.Добавить(Типы[ИндексТипа]);
		ОписаниеОдногоТипа = Новый ОписаниеТипов(ОдинТип);
		Возврат ОписаниеОдногоТипа.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Корректно = Ложь;
	Результат = Неопределено;
	Если Описание.kind = "string" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Строка");
		Если Корректно Тогда
			Корректно = Описание.length = 0 Или СтрДлина(Вход) <= Описание.length;
			Если Описание.fixedLength И Описание.length > 0 Тогда
				Корректно = СтрДлина(Вход) = Описание.length;
			КонецЕсли;
		КонецЕсли;
		Результат = Вход;
	ИначеЕсли Описание.kind = "number" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Число");
		Если Корректно Тогда
			Корректно = Окр(Вход, Описание.fractionDigits) = Вход
				И ?(Вход < 0, -Вход, Вход) < Pow(10, Описание.digits - Описание.fractionDigits)
				И (Не Описание.nonnegative Или Вход >= 0);
		КонецЕсли;
		Результат = Вход;
	ИначеЕсли Описание.kind = "boolean" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Булево");
		Результат = Вход;
	ИначеЕсли Описание.kind = "date" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Попытка
				Результат = ПрочитатьДатуJSON(Вход, ФорматДатыJSON.ISO);
				Корректно = Вход = ДатаСтрокой(Результат, Описание.parts = "date");
			Исключение
				Корректно = Ложь;
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли Описание.kind = "catalog" Тогда
		Идентификатор = УникальныйИдентификаторИзСтроки(Вход);
		Если Идентификатор <> Неопределено Тогда
			// Имя справочника получено из метаданных поля, не из строки пользователя.
			МетаСправочника = Метаданные.Справочники.Найти(Описание.catalog);
			Результат = Справочники[Описание.catalog].ПолучитьСсылку(Идентификатор);
			Корректно = СсылкаДоступна(МетаСправочника, Результат, ВидСсылки(Мета, МетаСправочника, Роль));
		КонецЕсли;
	ИначеЕсли Описание.kind = "document" Тогда
		Идентификатор = УникальныйИдентификаторИзСтроки(Вход);
		Если Идентификатор <> Неопределено Тогда
			МетаДокумента = Метаданные.Документы.Найти(Описание.document);
			Результат = Документы[Описание.document].ПолучитьСсылку(Идентификатор);
			Корректно = СсылкаДоступна(МетаДокумента, Результат, "document");
		КонецЕсли;
	ИначеЕсли Описание.kind = "enum" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Для Каждого ЗначениеМета Из Описание.values Цикл
				Если Вход = ЗначениеМета.name Тогда
					Результат = Перечисления[Описание.enumeration][Вход];
					Корректно = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли Описание.kind = "valueStorage" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Попытка
				Результат = Base64ВХранилище(Вход);
				Корректно = Истина;
			Исключение
				Корректно = Ложь;
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли Описание.kind = "uuid" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Попытка
				Результат = Новый УникальныйИдентификатор(Вход);
				Корректно = Вход = XMLСтрока(Результат);
			Исключение
				Корректно = Ложь;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Если Не Корректно Тогда
		Ошибка(Ошибки, Путь, "Недопустимое значение, тип, ограничение или ссылка; ожидается " + Описание.name);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Вид проверки ссылки на справочник: element, group или пустая строка, если ссылка здесь недопустима.
Функция ВидСсылки(Мета, МетаСправочника, Роль)
	Если Роль = "Родитель" Тогда
		Если МетаСправочника <> Мета Тогда
			Возврат "";
		КонецЕсли;
		Возврат ?(ЕстьГруппы(Мета), "group", "element");
	ИначеЕсли Роль = "Владелец" Тогда
		// Нужна ровно одна доступная элементарная ссылка среди справочников-владельцев.
		Совпадений = 0;
		Для Каждого Владелец Из Мета.Владельцы Цикл
			Если Владелец = МетаСправочника Тогда
				Совпадений = Совпадений + 1;
			КонецЕсли;
		КонецЦикла;
		Возврат ?(Совпадений = 1, "element", "");
	КонецЕсли;
	Возврат "element";
КонецФункции

Функция ЕстьГруппы(МетаСправочника)
	Возврат МетаСправочника.Иерархический
		И МетаСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
КонецФункции

// Мета — справочник или документ, уже сверенный с метаданными; Вид — element, group или document.
// element — существующий не помеченный на удаление элемент (при иерархии групп — не группа);
// group — группа; document — существующий не помеченный на удаление документ, проведённый допустим.
// Нет объекта и нет права — один и тот же отказ.
Функция СсылкаДоступна(Мета, Ссылка, Вид)
	ЭтоСправочник = Метаданные.Справочники.Найти(Мета.Имя) = Мета;
	Условие = "";
	Если Вид = "document" И Не ЭтоСправочник Тогда
		Условие = "";
	ИначеЕсли Вид = "element" И ЭтоСправочник Тогда
		Условие = ?(ЕстьГруппы(Мета), " И НЕ ЭтоГруппа", "");
	ИначеЕсли Вид = "group" И ЭтоСправочник И ЕстьГруппы(Мета) Тогда
		Условие = " И ЭтоГруппа";
	Иначе
		Возврат Ложь;
	КонецЕсли;
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Ложь;
	КонецЕсли;
	// Имя таблицы взято из метаданных, значение передаётся параметром.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ " + ?(ЭтоСправочник, "Справочник.", "Документ.") + Мета.Имя
		+ " ГДЕ Ссылка = &Ссылка И НЕ ПометкаУдаления" + Условие;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Попытка
		Возврат Не Запрос.Выполнить().Пустой();
	Исключение
		Если ИнформацияОбОшибке().ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
			Возврат Ложь;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

// Ищет справочники по наименованию, документы по номеру. Мета уже сверена РазобратьИмяТипа.
// Возвращает структуру items, hasMore. Без права чтения выдача пустая.
Функция НайтиОбъекты(Мета, СтрокаПоиска, Лимит) Экспорт
	ЭтоСправочник = Метаданные.Справочники.Найти(Мета.Имя) = Мета;
	Если ЭтоСправочник И Мета.ДлинаНаименования = 0 Тогда
		ВызватьИсключение "У справочника нет наименования";
	КонецЕсли;
	Элементы = Новый Массив;
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Новый Структура("items,hasMore", Элементы, Ложь);
	КонецЕсли;
	ЕстьГруппы = ЭтоСправочник И СчетаМагазинаМетаданные.СхемаОбъекта(Мета).hierarchical = "folders";
	// Имя таблицы взято из метаданных; число после ПЕРВЫЕ получено из проверенного лимита.
	Если ЭтоСправочник Тогда
		Запрос = ЗапросПоискаСправочника(Мета.Имя, ЕстьГруппы, Лимит);
	Иначе
		Запрос = ЗапросПоискаДокумента(Мета.Имя, Лимит);
	КонецЕсли;
	Запрос.УстановитьПараметр("Шаблон", "%" + ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(СтрокаПоиска) + "%");
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Если ИнформацияОбОшибке().ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
			Возврат Новый Структура("items,hasMore", Элементы, Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	ЕстьЕще = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() = Лимит Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("id", XMLСтрока(Выборка.Ссылка.УникальныйИдентификатор()));
		Элемент.Вставить("name", ?(ЭтоСправочник, Выборка.Наименование, Выборка.Номер));
		Если ЕстьГруппы Тогда
			Элемент.Вставить("isFolder", Выборка.ЭтоГруппа);
		КонецЕсли;
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Функция ЗапросПоискаСправочника(ИмяСправочника, ЕстьГруппы, Лимит)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0")
		+ " Ссылка, Наименование" + ?(ЕстьГруппы, ", ЭтоГруппа", "")
		+ " ИЗ Справочник." + ИмяСправочника
		+ " ГДЕ НЕ ПометкаУдаления И Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"""
		+ " УПОРЯДОЧИТЬ ПО Наименование, Ссылка";
	Возврат Запрос;
КонецФункции

Функция ЗапросПоискаДокумента(ИмяДокумента, Лимит)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0")
		+ " Ссылка, Номер ИЗ Документ." + ИмяДокумента
		+ " ГДЕ НЕ ПометкаУдаления И Номер ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"""
		+ " УПОРЯДОЧИТЬ ПО Номер, Ссылка";
	Возврат Запрос;
КонецФункции

// Переносит подготовленные значения в новый объект. Автозаполнение и обработка заполнения не вызываются.
// ЭтоГруппа объекту не присваивается: вид объекта задаёт метод создания менеджера.
Процедура Заполнить(Объект, Данные) Экспорт
	Для Каждого Поле Из Данные.header Цикл
		Если Поле.Ключ <> "ЭтоГруппа" Тогда
			Объект[Поле.Ключ] = Поле.Значение;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Таблица Из Данные.tables Цикл
		Для Каждого СтрокаДанных Из Таблица.Значение Цикл
			СтрокаОбъекта = Объект[Таблица.Ключ].Добавить();
			Для Каждого Поле Из СтрокаДанных Цикл
				СтрокаОбъекта[Поле.Ключ] = Поле.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Читает справочник или документ целиком. Мета уже сверена РазобратьИмяТипа, Идентификатор — УникальныйИдентификатор.
// Возвращает структуру type, id, header, tables либо Неопределено: объекта нет, нет права чтения
// или нет доступа к нему. Пометку удаления не фильтрует.
Функция ПрочитатьОбъект(Мета, Идентификатор) Экспорт
	ЭтоСправочник = Метаданные.Справочники.Найти(Мета.Имя) = Мета;
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Имя таблицы взято из метаданных, значение передаётся параметром.
	Если ЭтоСправочник Тогда
		Ссылка = Справочники[Мета.Имя].ПолучитьСсылку(Идентификатор);
	Иначе
		Ссылка = Документы[Мета.Имя].ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ " + ?(ЭтоСправочник, "Справочник.", "Документ.") + Мета.Имя
		+ " ГДЕ Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Попытка
		Если Запрос.Выполнить().Пустой() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		Если ИнформацияОбОшибке().ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Схема = СчетаМагазинаМетаданные.СхемаОбъекта(Мета);
	ЭтоГруппа = ЭтоГруппаОбъекта(Объект, Мета);
	Заголовок = Новый Соответствие;
	Для Каждого Поле Из Схема.fields Цикл
		// Поле, не применимое к группе или элементу, платформа читать не даёт: отдаём null.
		Если Не ПолеШапкиПрименяется(Мета, Поле.name, ЭтоГруппа) Тогда
			Заголовок.Вставить(Поле.name, Неопределено);
			Продолжить;
		КонецЕсли;
		Заголовок.Вставить(Поле.name, ЗначениеJSON(Объект[Поле.name], Поле, ТипыПоляОбъекта(Мета, Поле.name)));
	КонецЦикла;
	Таблицы = Новый Соответствие;
	Для Каждого Таблица Из Схема.tables Цикл
		МетаТаблицы = Мета.ТабличныеЧасти[Таблица.name];
		Строки = Новый Массив;
		Если Не ПрименяетсяКОбъекту(МетаТаблицы, Мета, ЭтоГруппа) Тогда
			Таблицы.Вставить(Таблица.name, Строки);
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаОбъекта Из Объект[Таблица.name] Цикл
			СтрокаJSON = Новый Соответствие;
			Для Каждого Поле Из Таблица.fields Цикл
				СтрокаJSON.Вставить(Поле.name,
					ЗначениеJSON(СтрокаОбъекта[Поле.name], Поле, ТипыПоляТаблицы(МетаТаблицы, Поле.name)));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
		КонецЦикла;
		Таблицы.Вставить(Таблица.name, Строки);
	КонецЦикла;
	Возврат Новый Структура("type,id,header,tables", Схема.type, XMLСтрока(Идентификатор), Заголовок, Таблицы);
КонецФункции

// Описание типов поля шапки: стандартный реквизит, реквизит или общий реквизит.
Функция ТипыПоляОбъекта(Мета, Имя)
	Для Каждого Реквизит Из Мета.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = Имя Тогда
			Возврат Реквизит.Тип;
		КонецЕсли;
	КонецЦикла;
	МетаПоля = Мета.Реквизиты.Найти(Имя);
	Если МетаПоля = Неопределено Тогда
		МетаПоля = Метаданные.ОбщиеРеквизиты.Найти(Имя);
	КонецЕсли;
	Возврат МетаПоля.Тип;
КонецФункции

Функция ТипыПоляТаблицы(МетаТаблицы, Имя)
	Для Каждого Реквизит Из МетаТаблицы.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = Имя Тогда
			Возврат Реквизит.Тип;
		КонецЕсли;
	КонецЦикла;
	Возврат МетаТаблицы.Реквизиты[Имя].Тип;
КонецФункции

// Переводит значение 1С в значение JSON по фактическому типу значения.
// Пустое значение — Неопределено (JSON null). Неподдерживаемый фактический тип — Неопределено.
// Поле с несколькими типами отдаёт структуру type, value; type равен name из схемы.
Функция ЗначениеJSON(Значение, Поле, Типы)
	Описание = СчетаМагазинаМетаданные.ОписаниеТипа(ТипЗнч(Значение), Типы);
	Если Описание.kind = "unsupported" Тогда
		Возврат Неопределено;
	ИначеЕсли Описание.kind = "catalog" Или Описание.kind = "document" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), XMLСтрока(Значение.УникальныйИдентификатор()), Неопределено);
	ИначеЕсли Описание.kind = "enum" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), ОбщегоНазначения.ИмяЗначенияПеречисления(Значение), Неопределено);
	ИначеЕсли Описание.kind = "date" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), ДатаСтрокой(Значение, Описание.parts = "date"), Неопределено);
	ИначеЕсли Описание.kind = "valueStorage" Тогда
		Результат = ХранилищеВBase64(Значение);
	ИначеЕсли Описание.kind = "uuid" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), XMLСтрока(Значение), Неопределено);
	Иначе
		Результат = Значение;
	КонецЕсли;
	Если Поле.types.Количество() > 1 Тогда
		Возврат Новый Структура("type,value", Описание.name, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Возвращает текст элемента ValueStorage штатной XML-сериализации (base64) либо Неопределено для пустого хранилища.
// Непустое хранилище без извлечённого текста — исключение, не null.
// Внутреннее значение хранилища не разбирается и в журнал не пишется.
Функция ХранилищеВBase64(Хранилище) Экспорт
	Если Не ЗначениеЗаполнено(Хранилище) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(Запись, Хранилище);
	ТекстXML = Запись.Закрыть();
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	Результат = Неопределено;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "ValueStorage"
			И Чтение.URIПространстваИмен = "http://v8.1c.ru/8.1/data/core" Тогда
			Текст = "";
			Пока Чтение.Прочитать() И Чтение.ТипУзла = ТипУзлаXML.Текст Цикл
				Текст = Текст + Чтение.Значение;
			КонецЦикла;
			Результат = Текст;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	// Хранилище заполнено, но текста нет: молча отдать null значило бы потерять данные.
	Если Результат = Неопределено Или Результат = "" Тогда
		ВызватьИсключение "Не удалось получить текст непустого хранилища значения";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Обратное к ХранилищеВBase64: собирает ХранилищеЗначения из текста элемента ValueStorage штатной XML-сериализации.
// Строку, которую платформа не принимает, отклоняет исключением до записи прикладного объекта.
// Содержимое хранилища не разбирается и не пишется в журнал.
Функция Base64ВХранилище(Текст) Экспорт
	Если ТипЗнч(Текст) <> Тип("Строка") Или Текст = "" Тогда
		ВызватьИсключение "Хранилище значения должно быть непустой строкой base64";
	КонецЕсли;
	// В текст элемента не должно попасть ничего, кроме base64 и пробельных символов.
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/= "
		+ Символы.ПС + Символы.ВК + Символы.Таб;
	Остаток = Текст;
	Для Индекс = 1 По СтрДлина(Алфавит) Цикл
		Остаток = СтрЗаменить(Остаток, Сред(Алфавит, Индекс, 1), "");
		Если Остаток = "" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Остаток <> "" Тогда
		ВызватьИсключение "Хранилище значения должно быть строкой base64";
	КонецЕсли;
	// Обёртку элемента берём у самой платформы: так форма совпадает с той, что отдаёт ХранилищеВBase64.
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(Запись, Новый ХранилищеЗначения(0));
	Образец = Запись.Закрыть();
	Если Лев(Образец, 2) = "<?" Тогда
		Образец = СокрЛ(Сред(Образец, СтрНайти(Образец, "?>") + 2));
	КонецЕсли;
	КонецНачала = СтрНайти(Образец, ">");
	НачалоКонца = СтрНайти(Образец, "</", НаправлениеПоиска.СКонца);
	Если КонецНачала = 0 Или НачалоКонца <= КонецНачала Тогда
		ВызватьИсключение "Не удалось собрать элемент ValueStorage";
	КонецЕсли;
	ТекстXML = Лев(Образец, КонецНачала) + Текст + Сред(Образец, НачалоКонца);
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	Попытка
		Результат = СериализаторXDTO.ПрочитатьXML(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение "Строка не принята как хранилище значения";
	КонецПопытки;
	Чтение.Закрыть();
	Если ТипЗнч(Результат) <> Тип("ХранилищеЗначения") Тогда
		ВызватьИсключение "Строка не принята как хранилище значения";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДатаСтрокой(Значение, ТолькоДата = Ложь) Экспорт
	Результат = Формат(Значение, "ДФ=yyyy-MM-dd");
	Если Не ТолькоДата Тогда
		Результат = Результат + "T" + Формат(Значение, "ДФ=HH:mm:ss");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция УникальныйИдентификаторИзСтроки(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрДлина(Значение) <> 36 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Результат = Новый УникальныйИдентификатор(Значение);
		Если НРег(Значение) = Строка(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция НайтиОписание(Описания, Имя) Экспорт
	Для Каждого Описание Из Описания Цикл
		Если Описание.name = Имя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Процедура Ошибка(Ошибки, Путь, Текст) Экспорт
	Ошибки.Добавить(Новый Структура("path,message", Путь, Текст));
КонецПроцедуры
