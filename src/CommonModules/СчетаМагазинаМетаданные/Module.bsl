Функция ОписаниеПоля(Реквизит, ДоступенДляЗаписи, Стандартный = Ложь) Экспорт
	Обязательно = Ложь;
	Если Не Стандартный Тогда
		Обязательно = Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
	КонецЕсли;
	Поле = Новый Структура("name,title,writable,required,types", Реквизит.Имя,
		Реквизит.Представление(), ДоступенДляЗаписи, Обязательно, Новый Массив);
	Для Каждого ТипПоля Из Реквизит.Тип.Типы() Цикл
		Описание = ОписаниеТипа(ТипПоля, Реквизит.Тип);
		Поле.types.Добавить(Описание);
		Если Описание.kind = "unsupported" Тогда
			Поле.writable = Ложь;
			Поле.Вставить("reason", "Тип поля не поддерживается этой версией: " + Описание.name);
		КонецЕсли;
	КонецЦикла;
	Если Не Поле.writable И Не Поле.Свойство("reason") Тогда
		Поле.Вставить("reason", "Поле недоступно для записи через этот сервис");
	КонецЕсли;
	Возврат Поле;
КонецФункции

Функция ОписаниеТипа(ТипПоля, ОписаниеТиповПоля) Экспорт
	Описание = Новый Структура("name,kind", Строка(ТипПоля), "unsupported");
	Если ТипПоля = Тип("Строка") Тогда
		Описание.name = "string";
		Описание.kind = "string";
		Описание.Вставить("length", ОписаниеТиповПоля.КвалификаторыСтроки.Длина);
		Описание.Вставить("fixedLength", ОписаниеТиповПоля.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная);
	ИначеЕсли ТипПоля = Тип("Число") Тогда
		Описание.name = "number";
		Описание.kind = "number";
		Квалификатор = ОписаниеТиповПоля.КвалификаторыЧисла;
		Описание.Вставить("digits", Квалификатор.Разрядность);
		Описание.Вставить("fractionDigits", Квалификатор.РазрядностьДробнойЧасти);
		Описание.Вставить("nonnegative", Квалификатор.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный);
	ИначеЕсли ТипПоля = Тип("Булево") Тогда
		Описание.name = "boolean";
		Описание.kind = "boolean";
	ИначеЕсли ТипПоля = Тип("Дата") Тогда
		Описание.name = "date";
		Описание.kind = "date";
		Часть = ОписаниеТиповПоля.КвалификаторыДаты.ЧастиДаты;
		Описание.Вставить("parts", ?(Часть = ЧастиДаты.Дата, "date", "dateTime"));
		Если Часть = ЧастиДаты.Время Тогда
			Описание.kind = "unsupported";
		КонецЕсли;
	ИначеЕсли ТипПоля = Тип("ХранилищеЗначения") Тогда
		Описание.name = "ValueStorage";
		Описание.kind = "valueStorage";
	ИначеЕсли ТипПоля = Тип("УникальныйИдентификатор") Тогда
		Описание.name = "UUID";
		Описание.kind = "uuid";
	Иначе
		МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Если МетаТипа <> Неопределено Тогда
			Если Метаданные.Справочники.Найти(МетаТипа.Имя) = МетаТипа Тогда
				Описание.name = "CatalogRef." + МетаТипа.Имя;
				Описание.kind = "catalog";
				Описание.Вставить("catalog", МетаТипа.Имя);
				Описание.Вставить("searchUrl", АдресПоискаТипа("Справочник." + МетаТипа.Имя));
			ИначеЕсли Метаданные.Документы.Найти(МетаТипа.Имя) = МетаТипа Тогда
				Описание.name = "DocumentRef." + МетаТипа.Имя;
				Описание.kind = "document";
				Описание.Вставить("document", МетаТипа.Имя);
				Описание.Вставить("searchUrl", АдресПоискаТипа("Документ." + МетаТипа.Имя));
			ИначеЕсли Метаданные.Перечисления.Найти(МетаТипа.Имя) = МетаТипа Тогда
				Описание.name = "EnumRef." + МетаТипа.Имя;
				Описание.kind = "enum";
				Описание.Вставить("enumeration", МетаТипа.Имя);
				Описание.Вставить("values", Новый Массив);
				Для Каждого ЗначениеМета Из МетаТипа.ЗначенияПеречисления Цикл
					Описание.values.Добавить(Новый Структура("name,title", ЗначениеМета.Имя, ЗначениеМета.Представление()));
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Описание;
КонецФункции

Функция АдресПоискаТипа(ИмяТипа)
	Возврат "/search?type=" + КодироватьСтроку(ИмяТипа, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Разбирает имя типа маршрута вида Справочник.<Имя> или Документ.<Имя>.
// Возвращает структуру kind, metadata, typeName, error.
// kind: catalog, document или пустая строка. error: пустая строка, malformed, unsupported, not_found.
Функция РазобратьИмяТипа(Имя) Экспорт
	Результат = Новый Структура("kind,metadata,typeName,error", "", Неопределено, "", "malformed");
	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;
	Части = СтрРазделить(Имя, ".", Истина);
	Если Части.Количество() <> 2 Или ПустаяСтрока(Части[0]) Или ПустаяСтрока(Части[1]) Тогда
		Возврат Результат;
	КонецЕсли;
	Если Части[0] = "Справочник" Тогда
		Вид = "catalog";
		Мета = Метаданные.Справочники.Найти(Части[1]);
	ИначеЕсли Части[0] = "Документ" Тогда
		Вид = "document";
		Мета = Метаданные.Документы.Найти(Части[1]);
	Иначе
		// Чужой вид не ищем: даже существующий объект остаётся неподдерживаемым.
		Результат.error = "unsupported";
		Возврат Результат;
	КонецЕсли;
	Результат.kind = Вид;
	Если Мета = Неопределено Тогда
		Результат.error = "not_found";
		Возврат Результат;
	КонецЕсли;
	Результат.metadata = Мета;
	Результат.typeName = Части[0] + "." + Части[1];
	Результат.error = "";
	Возврат Результат;
КонецФункции

// Ищет справочники и документы по подстроке имени или синонима без учёта регистра.
// Шаблонные символы не интерпретируются. Возвращает структуру items, hasMore.
Функция НайтиТипы(СтрокаПоиска, Лимит) Экспорт
	Шаблон = НРег(СокрЛП(СтрокаПоиска));
	Найденные = Новый ТаблицаЗначений;
	Найденные.Колонки.Добавить("name");
	Найденные.Колонки.Добавить("title");
	Найденные.Колонки.Добавить("kind");
	ДобавитьСовпавшиеТипы(Найденные, Метаданные.Справочники, "Справочник", "catalog", Шаблон);
	ДобавитьСовпавшиеТипы(Найденные, Метаданные.Документы, "Документ", "document", Шаблон);
	Найденные.Сортировать("name");
	Элементы = Новый Массив;
	ЕстьЕще = Ложь;
	Для Каждого СтрокаТипа Из Найденные Цикл
		Если Элементы.Количество() = Лимит Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Элементы.Добавить(Новый Структура("name,title,kind", СтрокаТипа.name, СтрокаТипа.title, СтрокаТипа.kind));
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Процедура ДобавитьСовпавшиеТипы(Найденные, Коллекция, Вид, КодВида, Шаблон)
	Для Каждого Мета Из Коллекция Цикл
		Представление = Мета.Представление();
		Если СтрНайти(НРег(Мета.Имя), Шаблон) > 0 Или СтрНайти(НРег(Представление), Шаблон) > 0 Тогда
			СтрокаТипа = Найденные.Добавить();
			СтрокаТипа.name = Вид + "." + Мета.Имя;
			СтрокаТипа.title = Представление;
			СтрокаТипа.kind = КодВида;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Описывает справочник или документ по живым метаданным: поля, таблицы и правила.
Функция СхемаОбъекта(Мета) Экспорт
	ЭтоСправочник = Метаданные.Справочники.Найти(Мета.Имя) = Мета;
	Результат = Новый Структура;
	Результат.Вставить("type", ?(ЭтоСправочник, "Справочник.", "Документ.") + Мета.Имя);
	Результат.Вставить("title", Мета.Представление());
	Результат.Вставить("kind", ?(ЭтоСправочник, "catalog", "document"));
	Если ЭтоСправочник Тогда
		Результат.Вставить("hierarchical", ВидИерархииСправочника(Мета));
		Владельцы = Новый Массив;
		Для Каждого Владелец Из Мета.Владельцы Цикл
			Владельцы.Добавить("Справочник." + Владелец.Имя);
		КонецЦикла;
		Результат.Вставить("owners", Владельцы);
	КонецЕсли;
	Результат.Вставить("fields", ПоляОбъекта(Мета, ЭтоСправочник));
	Результат.Вставить("tables", ТаблицыОбъекта(Мета));
	Результат.Вставить("rules", ПравилаОбъекта());
	Возврат Результат;
КонецФункции

Функция ВидИерархииСправочника(Мета)
	Если Не Мета.Иерархический Тогда
		Возврат "none";
	КонецЕсли;
	Если Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Возврат "folders";
	КонецЕсли;
	Возврат "items";
КонецФункции

Функция ПоляОбъекта(Мета, ЭтоСправочник)
	Поля = Новый Массив;
	Для Каждого Реквизит Из Мета.СтандартныеРеквизиты Цикл
		Поле = СтандартноеПоле(Реквизит, Мета, ЭтоСправочник);
		Если Поле <> Неопределено Тогда
			Поля.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Поля.Добавить(ОписаниеПоля(Реквизит, Истина));
	КонецЦикла;
	Для Каждого ОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Если ОбщийРеквизитИспользуется(ОбщийРеквизит, Мета) Тогда
			Поле = ОписаниеПоля(ОбщийРеквизит, Ложь, Истина);
			Поле.Вставить("reason", "Общие реквизиты этой версией не записываются");
			Поля.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;
	Возврат Поля;
КонецФункции

// Возвращает Неопределено, если стандартного реквизита у объекта фактически нет.
Функция СтандартноеПоле(Реквизит, Мета, ЭтоСправочник)
	Имя = Реквизит.Имя;
	Обязательно = Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
	Доступно = Ложь;
	Причина = "Стандартное техническое поле назначает 1С";
	Если ЭтоСправочник Тогда
		Если Имя = "Наименование" Тогда
			Если Мета.ДлинаНаименования = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			Доступно = Истина;
		ИначеЕсли Имя = "Код" Тогда
			Если Мета.ДлинаКода = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			Если Мета.Автонумерация Тогда
				Обязательно = Ложь;
				Причина = "Код назначает 1С";
			Иначе
				Доступно = Истина;
			КонецЕсли;
		ИначеЕсли Имя = "ЭтоГруппа" Тогда
			Если ВидИерархииСправочника(Мета) <> "folders" Тогда
				Возврат Неопределено;
			КонецЕсли;
			Доступно = Истина;
			Обязательно = Ложь;
		ИначеЕсли Имя = "Родитель" Тогда
			Если Не Мета.Иерархический Тогда
				Возврат Неопределено;
			КонецЕсли;
			Доступно = Истина;
		ИначеЕсли Имя = "Владелец" Тогда
			Если Мета.Владельцы.Количество() = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			Доступно = Истина;
		КонецЕсли;
	ИначеЕсли Имя = "Дата" Тогда
		Доступно = Истина;
		Обязательно = Истина;
	КонецЕсли;
	Если Не Доступно Тогда
		Обязательно = Ложь;
	КонецЕсли;
	Поле = ОписаниеПоля(Реквизит, Доступно, Истина);
	Поле.required = Обязательно;
	Если Не Доступно Тогда
		Поле.Вставить("reason", Причина);
	КонецЕсли;
	Возврат Поле;
КонецФункции

Функция ОбщийРеквизитИспользуется(ОбщийРеквизит, Мета)
	Для Каждого Элемент Из ОбщийРеквизит.Состав Цикл
		Если Элемент.Метаданные = Мета Тогда
			Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита;
			Если Элемент.Использование = Использование.Использовать Тогда
				Возврат Истина;
			КонецЕсли;
			Возврат Элемент.Использование = Использование.Авто
				И ОбщийРеквизит.АвтоИспользование = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ТаблицыОбъекта(Мета)
	Таблицы = Новый Массив;
	Для Каждого Таблица Из Мета.ТабличныеЧасти Цикл
		Доступна = Таблица.Имя <> "ДополнительныеРеквизиты";
		Причина = "Дополнительные свойства БСП не поддерживаются этой версией";
		Описание = Новый Структура("name,title,writable,required,fields", Таблица.Имя,
			Таблица.Представление(), Доступна,
			Таблица.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку, Новый Массив);
		Если Не Доступна Тогда
			Описание.Вставить("reason", Причина);
		КонецЕсли;
		Для Каждого Реквизит Из Таблица.СтандартныеРеквизиты Цикл
			Поле = ОписаниеПоля(Реквизит, Ложь, Истина);
			Поле.Вставить("reason", "Стандартное техническое поле назначает 1С");
			Описание.fields.Добавить(Поле);
		КонецЦикла;
		Для Каждого Реквизит Из Таблица.Реквизиты Цикл
			Поле = ОписаниеПоля(Реквизит, Доступна);
			Если Не Доступна Тогда
				Поле.Вставить("reason", Причина);
			КонецЕсли;
			Описание.fields.Добавить(Поле);
		КонецЦикла;
		Таблицы.Добавить(Описание);
	КонецЦикла;
	Возврат Таблицы;
КонецФункции

Функция ПравилаОбъекта()
	Правила = Новый Структура;
	Правила.Вставить("validation", "Окончательное решение принимает штатная проверка заполнения 1С; условные правила зависят от данных и настроек базы");
	Правила.Вставить("dates", "ISO 8601 без Z и без смещения; часть Дата — YYYY-MM-DD; дата-время — местное время базы");
	Правила.Вставить("null", "null — штатное пустое значение типа");
	Правила.Вставить("amounts", "Суммы передаёт клиент; сервис их не рассчитывает и не вызывает заполнение");
	Правила.Вставить("valueStorage", "Хранилище значения — base64 текста элемента ValueStorage штатной XML-сериализации, без тегов");
	Возврат Правила;
КонецФункции
