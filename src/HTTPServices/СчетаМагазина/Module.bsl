Функция НайтиТипы(Запрос)
	Попытка
		СтрокаПоиска = СокрЛП(ПараметрЗапроса(Запрос, "q"));
		Если СтрокаПоиска = "" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр q обязателен и не может быть пустым", "q");
		КонецЕсли;
		Лимит = 20;
		Если Не РазобратьЛимит(Запрос, Лимит) Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр limit должен быть целым числом от 1 до 100", "limit");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.НайтиТипы(СтрокаПоиска, Лимит));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ОписатьТип(Запрос)
	Попытка
		Разбор = СчетаМагазинаМетаданные.РазобратьИмяТипа(ПараметрЗапроса(Запрос, "name"));
		Если Разбор.error = "malformed" Тогда
			Возврат ОтказJSON(400, "invalid_request",
				"Имя типа должно иметь вид Справочник.<Имя> или Документ.<Имя>", "name");
		ИначеЕсли Разбор.error = "unsupported" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Вид метаданных не поддерживается", "name");
		ИначеЕсли Разбор.error = "not_found" Тогда
			Возврат ОтказJSON(404, "not_found", "Тип не найден");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.СхемаОбъекта(Разбор.metadata));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ПараметрЗапроса(Запрос, Имя)
	Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

// Отсутствующий limit равен 20; иначе допустимо целое от 1 до 100 без знака и пробелов.
Функция РазобратьЛимит(Запрос, Лимит)
	Значение = Запрос.ПараметрыЗапроса.Получить("limit");
	Если Значение = Неопределено Тогда
		Лимит = 20;
		Возврат Истина;
	КонецЕсли;
	Если Не Цифры(Значение) Или СтрДлина(Значение) > 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	Лимит = Число(Значение);
	Возврат Лимит >= 1 И Лимит <= 100;
КонецФункции

Функция НайтиОбъекты(Запрос)
	Попытка
		Разбор = СчетаМагазинаМетаданные.РазобратьИмяТипа(ПараметрЗапроса(Запрос, "type"));
		Если Разбор.error = "malformed" Тогда
			Возврат ОтказJSON(400, "invalid_request",
				"Имя типа должно иметь вид Справочник.<Имя> или Документ.<Имя>", "type");
		ИначеЕсли Разбор.error = "unsupported" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Вид метаданных не поддерживается", "type");
		ИначеЕсли Разбор.error = "not_found" Тогда
			Возврат ОтказJSON(404, "not_found", "Тип не найден");
		КонецЕсли;
		СтрокаПоиска = СокрЛП(ПараметрЗапроса(Запрос, "q"));
		Если СтрокаПоиска = "" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр q обязателен и не может быть пустым", "q");
		КонецЕсли;
		Лимит = 20;
		Если Не РазобратьЛимит(Запрос, Лимит) Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр limit должен быть целым числом от 1 до 100", "limit");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаДанные.НайтиОбъекты(Разбор.metadata, СтрокаПоиска, Лимит));
	Исключение
		Информация = ИнформацияОбОшибке();
		Если Информация.Описание = "У справочника нет наименования" Тогда
			Возврат ОтказJSON(400, "invalid_request", Информация.Описание, "type");
		КонецЕсли;
		Возврат НепредвиденнаяОшибка(Информация);
	КонецПопытки;
КонецФункции

Функция ПрочитатьОбъект(Запрос)
	Попытка
		Разбор = СчетаМагазинаМетаданные.РазобратьИмяТипа(ПараметрЗапроса(Запрос, "type"));
		Если Разбор.error = "malformed" Тогда
			Возврат ОтказJSON(400, "invalid_request",
				"Имя типа должно иметь вид Справочник.<Имя> или Документ.<Имя>", "type");
		ИначеЕсли Разбор.error = "unsupported" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Вид метаданных не поддерживается", "type");
		ИначеЕсли Разбор.error = "not_found" Тогда
			Возврат ОтказJSON(404, "not_found", "Тип не найден");
		КонецЕсли;
		Идентификатор = СчетаМагазинаДанные.УникальныйИдентификаторИзСтроки(ПараметрЗапроса(Запрос, "id"));
		Если Идентификатор = Неопределено Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр id должен быть UUID в виде строки из 36 символов", "id");
		КонецЕсли;
		Результат = СчетаМагазинаДанные.ПрочитатьОбъект(Разбор.metadata, Идентификатор);
		Если Результат = Неопределено Тогда
			Возврат ОтказJSON(404, "not_found", "Объект не найден");
		КонецЕсли;
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция СоздатьОбъект(Запрос)
	Попытка
		Если Не ЭтоТелоJSON(Запрос) Тогда
			Возврат ОтказJSON(415, "unsupported_media_type", "Тип тела запроса должен быть application/json");
		КонецЕсли;
		Данные = Неопределено;
		Если Не РазобратьТелоJSON(Запрос, Данные) Тогда
			Возврат ОтказJSON(400, "invalid_request", "Тело запроса не является корректным JSON без лишних данных");
		КонецЕсли;
		Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
			Возврат ОтказJSON(400, "invalid_request", "Тело должно быть объектом с type, header и tables");
		КонецЕсли;
		Разбор = СчетаМагазинаМетаданные.РазобратьИмяТипа(Данные.Получить("type"));
		Если Разбор.error = "malformed" Тогда
			Возврат ОтказJSON(400, "invalid_request",
				"Имя типа должно иметь вид Справочник.<Имя> или Документ.<Имя>", "type");
		ИначеЕсли Разбор.error = "unsupported" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Вид метаданных не поддерживается", "type");
		ИначеЕсли Разбор.error = "not_found" Тогда
			Возврат ОтказJSON(404, "not_found", "Тип не найден");
		КонецЕсли;
		Мета = Разбор.metadata;
		Если Не ПравоДоступа("Добавление", Мета) Тогда
			Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
		КонецЕсли;
		Ошибки = Новый Массив;
		Подготовлено = СчетаМагазинаДанные.Подготовить(Мета, Данные, Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			Возврат ОшибкаJSON(400, "invalid_request",
				?(Ошибки.Количество() = 1, Ошибки[0].message, "Запрос не прошёл проверку структуры и значений"), Ошибки);
		КонецЕсли;
		Возврат СоздатьВТранзакции(Мета, Подготовлено);
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// Заголовок Content-Type ищется без учёта регистра имени; тип должен начинаться с application/json.
Функция ЭтоТелоJSON(Запрос)
	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "content-type" Тогда
			Возврат СтрНачинаетсяС(НРег(СокрЛП(Заголовок.Значение)), "application/json");
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Читает тело как UTF-8 JSON до конца потока: после значения допустимы только пробельные символы.
// Текст тела в сообщение и в журнал не попадает.
Функция РазобратьТелоJSON(Запрос, Данные)
	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Данные = ПрочитатьJSON(Чтение, Истина);
		ЕстьХвост = Чтение.Прочитать();
	Исключение
		Чтение.Закрыть();
		Возврат Ложь;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Не ЕстьХвост;
КонецФункции

// Очередь сообщений очищается до транзакции и после проверки заполнения.
// Отказ, неудачное чтение или исключение откатывают транзакцию: объект не остаётся.
Функция СоздатьВТранзакции(Мета, Данные)
	ЭтоСправочник = Метаданные.Справочники.Найти(Мета.Имя) = Мета;
	ПолучитьСообщенияПользователю(Истина);
	НачатьТранзакцию();
	Попытка
		Если ЭтоСправочник Тогда
			Менеджер = Справочники[Мета.Имя];
			Если Данные.header.Получить("ЭтоГруппа") = Истина Тогда
				Объект = Менеджер.СоздатьГруппу();
			Иначе
				Объект = Менеджер.СоздатьЭлемент();
			КонецЕсли;
		Иначе
			Объект = Документы[Мета.Имя].СоздатьДокумент();
		КонецЕсли;
		СчетаМагазинаДанные.Заполнить(Объект, Данные);
		Если Не Объект.ПроверитьЗаполнение() Тогда
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Ответ = ОшибкаJSON(422, "validation_failed", "Объект не прошёл проверку заполнения",
				ОшибкиЗаполнения(Сообщения, Объект));
			ОтменитьТранзакцию();
			Возврат Ответ;
		КонецЕсли;
		Если ЭтоСправочник Тогда
			Объект.Записать();
		Иначе
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Если Объект.Проведен Тогда
				ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
					"Документ " + Мета.Имя + " оказался проведённым после записи без проведения; запись отменена");
				Ответ = ОтказJSON(500, "internal_error", "Документ записан не в том состоянии; запись отменена");
				ОтменитьТранзакцию();
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;
		Результат = СчетаМагазинаДанные.ПрочитатьОбъект(Мета, Объект.Ссылка.УникальныйИдентификатор());
		Если Результат = Неопределено Тогда
			// Создать объект можно, а прочитать записанное — нет: ответ без чтения не строим.
			Ответ = ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
			ОтменитьТранзакцию();
			Возврат Ответ;
		КонецЕсли;
		Ответ = ОтветJSON(201, Результат);
		ЗафиксироватьТранзакцию();
		Возврат Ответ;
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция ОшибкиЗаполнения(Сообщения, Объект)
	Ошибки = Новый Массив;
	Схема = СчетаМагазинаМетаданные.СхемаОбъекта(Объект.Метаданные());
	Если Сообщения <> Неопределено Тогда
		Для Каждого Сообщение Из Сообщения Цикл
			Путь = ПутьПоля(Сообщение.Поле, Объект, Схема);
			СчетаМагазинаДанные.Ошибка(Ошибки, Путь, Сообщение.Текст);
		КонецЦикла;
	КонецЕсли;
	Если Ошибки.Количество() = 0 Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, Неопределено, "Штатная проверка заполнения отказала без сообщения");
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

// Схема — СхемаОбъекта записываемого объекта.
Функция ПутьПоля(ИмяПоля, Объект, Схема)
	// Только точное сопоставление метаданным, без угадывания поля по тексту сообщения.
	Если СчетаМагазинаДанные.НайтиОписание(Схема.fields, ИмяПоля) <> Неопределено Тогда
		Возврат "header." + ИмяПоля;
	КонецЕсли;
	Мета = Объект.Метаданные();
	ЭтоГруппа = СчетаМагазинаДанные.ЭтоГруппаОбъекта(Объект, Мета);
	Для Каждого Таблица Из Схема.tables Цикл
		// Табличную часть, не применимую к группе или элементу, не читаем: платформа откажет.
		Если Не СчетаМагазинаДанные.ПрименяетсяКОбъекту(Мета.ТабличныеЧасти[Таблица.name], Мета, ЭтоГруппа) Тогда
			Продолжить;
		КонецЕсли;
		Для Индекс = 0 По Объект[Таблица.name].Количество() - 1 Цикл
			Для Каждого Поле Из Таблица.fields Цикл
				Путь = Таблица.name + "[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]." + Поле.name;
				Если ИмяПоля = Путь Тогда
					Возврат "tables." + Путь;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Цифры(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ОтветJSON(Статус, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ТекстJSON = Запись.Закрыть();
	Ответ = Новый HTTPСервисОтвет(Статус);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(Статус, Код, Текст, Подробности)
	Возврат ОтветJSON(Статус, Новый Структура("error", Новый Структура("code,message,details", Код, Текст, Подробности)));
КонецФункции

Функция ОтказJSON(Статус, Код, Текст, Путь = Неопределено)
	Подробности = Новый Массив;
	СчетаМагазинаДанные.Ошибка(Подробности, Путь, Текст);
	Возврат ОшибкаJSON(Статус, Код, Текст, Подробности);
КонецФункции

Функция ЭтоНарушениеПрав(Информация)
	Возврат Информация.ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь);
КонецФункции

Функция НепредвиденнаяОшибка(Информация)
	Если ЭтоНарушениеПрав(Информация) Тогда
		Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
	КонецЕсли;
	ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Информация));
	Возврат ОтказJSON(500, "internal_error", КраткоеПредставлениеОшибки(Информация));
КонецФункции
