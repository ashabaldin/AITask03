Функция НайтиТипы(Запрос)
	Попытка
		СтрокаПоиска = СокрЛП(ПараметрЗапроса(Запрос, "q"));
		Если СтрокаПоиска = "" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр q обязателен и не может быть пустым", "q");
		КонецЕсли;
		Лимит = 20;
		Если Не РазобратьЛимит(Запрос, Лимит) Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр limit должен быть целым числом от 1 до 100", "limit");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.НайтиТипы(СтрокаПоиска, Лимит));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ОписатьТип(Запрос)
	Попытка
		Разбор = СчетаМагазинаМетаданные.РазобратьИмяТипа(ПараметрЗапроса(Запрос, "name"));
		Если Разбор.error = "malformed" Тогда
			Возврат ОтказJSON(400, "invalid_request",
				"Имя типа должно иметь вид Справочник.<Имя> или Документ.<Имя>", "name");
		ИначеЕсли Разбор.error = "unsupported" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Вид метаданных не поддерживается", "name");
		ИначеЕсли Разбор.error = "not_found" Тогда
			Возврат ОтказJSON(404, "not_found", "Тип не найден");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.СхемаОбъекта(Разбор.metadata));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ПараметрЗапроса(Запрос, Имя)
	Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

// Отсутствующий limit равен 20; иначе допустимо целое от 1 до 100 без знака и пробелов.
Функция РазобратьЛимит(Запрос, Лимит)
	Значение = Запрос.ПараметрыЗапроса.Получить("limit");
	Если Значение = Неопределено Тогда
		Лимит = 20;
		Возврат Истина;
	КонецЕсли;
	Если Не Цифры(Значение) Или СтрДлина(Значение) > 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	Лимит = Число(Значение);
	Возврат Лимит >= 1 И Лимит <= 100;
КонецФункции

Функция НайтиОбъекты(Запрос)
	Попытка
		Разбор = СчетаМагазинаМетаданные.РазобратьИмяТипа(ПараметрЗапроса(Запрос, "type"));
		Если Разбор.error = "malformed" Тогда
			Возврат ОтказJSON(400, "invalid_request",
				"Имя типа должно иметь вид Справочник.<Имя> или Документ.<Имя>", "type");
		ИначеЕсли Разбор.error = "unsupported" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Вид метаданных не поддерживается", "type");
		ИначеЕсли Разбор.error = "not_found" Тогда
			Возврат ОтказJSON(404, "not_found", "Тип не найден");
		КонецЕсли;
		СтрокаПоиска = СокрЛП(ПараметрЗапроса(Запрос, "q"));
		Если СтрокаПоиска = "" Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр q обязателен и не может быть пустым", "q");
		КонецЕсли;
		Лимит = 20;
		Если Не РазобратьЛимит(Запрос, Лимит) Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр limit должен быть целым числом от 1 до 100", "limit");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаДанные.НайтиОбъекты(Разбор.metadata, СтрокаПоиска, Лимит));
	Исключение
		Информация = ИнформацияОбОшибке();
		Если Информация.Описание = "У справочника нет наименования" Тогда
			Возврат ОтказJSON(400, "invalid_request", Информация.Описание, "type");
		КонецЕсли;
		Возврат НепредвиденнаяОшибка(Информация);
	КонецПопытки;
КонецФункции

Функция ПрочитатьОбъект(Запрос)
	// GET /object — не реализовано.
	Возврат НеРеализовано("GET /object");
КонецФункции

Функция СоздатьОбъект(Запрос)
	// POST /object — не реализовано.
	Возврат НеРеализовано("POST /object");
КонецФункции

Функция НеРеализовано(Маршрут)
	Возврат ОтказJSON(501, "not_implemented", "Маршрут " + Маршрут + " ещё не реализован");
КонецФункции

Функция ОшибкиЗаполнения(Сообщения, Объект)
	Ошибки = Новый Массив;
	Если Сообщения <> Неопределено Тогда
		Для Каждого Сообщение Из Сообщения Цикл
			Путь = ПутьПоля(Сообщение.Поле, Объект);
			СчетаМагазинаДанные.Ошибка(Ошибки, Путь, Сообщение.Текст);
		КонецЦикла;
	КонецЕсли;
	Если Ошибки.Количество() = 0 Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, Неопределено, "Штатная проверка заполнения отказала без сообщения");
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

Функция ПутьПоля(ИмяПоля, Объект)
	// Только точное сопоставление метаданным, без угадывания поля по тексту сообщения.
	Схема = СчетаМагазинаМетаданные.Схема();
	Если СчетаМагазинаДанные.НайтиОписание(Схема.fields, ИмяПоля) <> Неопределено Тогда
		Возврат "header." + ИмяПоля;
	КонецЕсли;
	Для Каждого Таблица Из Схема.tables Цикл
		Для Индекс = 0 По Объект[Таблица.name].Количество() - 1 Цикл
			Для Каждого Поле Из Таблица.fields Цикл
				Путь = Таблица.name + "[" + Формат(Индекс, "ЧГ=0") + "]." + Поле.name;
				Если ИмяПоля = Путь Тогда
					Возврат "tables." + Путь;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Цифры(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ОтветJSON(Статус, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ТекстJSON = Запись.Закрыть();
	Ответ = Новый HTTPСервисОтвет(Статус);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(Статус, Код, Текст, Подробности)
	Возврат ОтветJSON(Статус, Новый Структура("error", Новый Структура("code,message,details", Код, Текст, Подробности)));
КонецФункции

Функция ОтказJSON(Статус, Код, Текст, Путь = Неопределено)
	Подробности = Новый Массив;
	СчетаМагазинаДанные.Ошибка(Подробности, Путь, Текст);
	Возврат ОшибкаJSON(Статус, Код, Текст, Подробности);
КонецФункции

Функция ЭтоНарушениеПрав(Информация)
	Возврат Информация.ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь);
КонецФункции

Функция НепредвиденнаяОшибка(Информация)
	Если ЭтоНарушениеПрав(Информация) Тогда
		Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
	КонецЕсли;
	ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Информация));
	Возврат ОтказJSON(500, "internal_error", КраткоеПредставлениеОшибки(Информация));
КонецФункции
