# Запросы к сервису objects. Адрес, авторизация и идентификаторы — в .env рядом.
# Пока расширение не загружено в базу, маршруты отвечают 501 / not_implemented.
# После загрузки ожидания указаны под каждым запросом.

### Найти тип по слову
# Ожидание: 200; в items есть name=Справочник._ДемоПартнеры, title=Демо: Партнеры, kind=catalog.
GET {{$dotenv OBJECTS_URL}}/types?q=партнер
Authorization: {{$dotenv OBJECTS_AUTH}}

### Пустая строка поиска
# Ожидание: 400, error.code=invalid_request, details[0].path=q.
GET {{$dotenv OBJECTS_URL}}/types?q=
Authorization: {{$dotenv OBJECTS_AUTH}}

### Символ % ищется буквально
# Ожидание: 200; у каждого элемента имя или синоним содержит %. Пустой items допустим.
GET {{$dotenv OBJECTS_URL}}/types?q=%25&limit=20
Authorization: {{$dotenv OBJECTS_AUTH}}

### Лимит вне диапазона
# Ожидание: 400, invalid_request, details[0].path=limit.
GET {{$dotenv OBJECTS_URL}}/types?limit=0&q=счет
Authorization: {{$dotenv OBJECTS_AUTH}}

### Лимит 1
# Ожидание: 200; items не длиннее 1; при длине 1 поле hasMore булево.
GET {{$dotenv OBJECTS_URL}}/types?q=счет&limit=1
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать иерархический справочник с группами
# Ожидание: 200; hierarchical=folders, owners=[]; Наименование writable и required;
# Код writable=false, reason "Код назначает 1С"; ЭтоГруппа writable; поля Владелец нет.
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник._ДемоПартнеры
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать неиерархический справочник
# Ожидание: 200; hierarchical=none; полей ЭтоГруппа, Родитель, Владелец нет.
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник._ДемоОрганизации
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать справочник с иерархией элементов и владельцем
# Ожидание: 200; hierarchical=items; owners содержит Справочник._ДемоКонтрагенты;
# поле Родитель есть, поля ЭтоГруппа нет.
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник._ДемоДоговорыКонтрагентов
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать подчинённый справочник
# Ожидание: 200; owners содержит Справочник._ДемоПартнеры; поле Владелец writable.
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник._ДемоКонтактныеЛицаПартнеров
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать документ
# Ожидание: 200; kind=document; свойств hierarchical и owners нет; Дата writable и required;
# Номер writable=false; таблица ДополнительныеРеквизиты writable=false,
# reason "Дополнительные свойства БСП не поддерживаются этой версией".
# Прикладные реквизиты списком не проверяются: достаточно стандартных полей и непустого fields.
GET {{$dotenv OBJECTS_URL}}/type?name=Документ._ДемоСчетНаОплатуПокупателю
Authorization: {{$dotenv OBJECTS_AUTH}}

### Хранилище значения
# Ожидание: 200; у поля Настройки тип name=ValueStorage, kind=valueStorage.
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник.ВариантыОтчетов
Authorization: {{$dotenv OBJECTS_AUTH}}

### Уникальный идентификатор в табличной части
# Ожидание: 200; у таблицы Полномочия поле ИдентификаторПолномочия имеет kind=uuid, name=UUID.
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник.МашиночитаемыеДоверенности
Authorization: {{$dotenv OBJECTS_AUTH}}

### Неподдерживаемый вид метаданных
# Ожидание: 400, invalid_request, сообщение "Вид метаданных не поддерживается".
GET {{$dotenv OBJECTS_URL}}/type?name=РегистрСведений._ДемоРеестрСкладскихДокументов
Authorization: {{$dotenv OBJECTS_AUTH}}

### Тип не найден
# Ожидание: 404, not_found, сообщение "Тип не найден".
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник.НетТакого
Authorization: {{$dotenv OBJECTS_AUTH}}

### Имя без точки
# Ожидание: 400, invalid_request, details[0].path=name.
GET {{$dotenv OBJECTS_URL}}/type?name=безточки
Authorization: {{$dotenv OBJECTS_AUTH}}

### Найти партнёров по наименованию
# Ожидание: 200; items/hasMore; у элемента, если он есть, есть id, name, isFolder.
# Если партнёр называется иначе, замените только литерал q на часть его наименования.
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоПартнеры&q=Альфа
Authorization: {{$dotenv OBJECTS_AUTH}}

### Символ % в поиске объектов ищется буквально
# Ожидание: 200; PARTNER_ID в items нет.
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоПартнеры&q=%25
Authorization: {{$dotenv OBJECTS_AUTH}}

### Пустая строка поиска объектов
# Ожидание: 400, invalid_request, details[0].path=q.
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоПартнеры&q=
Authorization: {{$dotenv OBJECTS_AUTH}}

### Лимит поиска объектов вне диапазона
# Ожидание: 400, invalid_request, details[0].path=limit.
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоПартнеры&limit=0&q=Альфа
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск объектов с лимитом 1
# Ожидание: 200; длина items не больше 1.
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоПартнеры&q=а&limit=1
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск объектов с лимитом 2
# Ожидание: 200; длина items не больше 2; если в предыдущем ответе hasMore=true,
# здесь элементов не меньше, чем там.
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоПартнеры&q=а&limit=2
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск в несуществующем типе
# Ожидание: 404, not_found, сообщение "Тип не найден".
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник.НетТакого&q=А
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск в неподдерживаемом виде метаданных
# Ожидание: 400, invalid_request, сообщение "Вид метаданных не поддерживается".
GET {{$dotenv OBJECTS_URL}}/search?type=РегистрСведений._ДемоРеестрСкладскихДокументов&q=А
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск документов по номеру
# Ожидание: 200; items/hasMore. Пустая выдача допустима, пока счёт не создан.
GET {{$dotenv OBJECTS_URL}}/search?type=Документ._ДемоСчетНаОплатуПокупателю&q=0000
Authorization: {{$dotenv OBJECTS_AUTH}}

### Прочитать партнёра
# Ожидание: 200; id равен PARTNER_ID, type=Справочник._ДемоПартнеры;
# в header есть Наименование, ЭтоГруппа, ПометкаУдаления, Ссылка;
# tables содержит ДополнительныеРеквизиты, даже если массив пуст.
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник._ДемоПартнеры&id={{$dotenv PARTNER_ID}}
Authorization: {{$dotenv OBJECTS_AUTH}}

### Прочитать несуществующий объект
# Ожидание: 404, not_found, сообщение "Объект не найден".
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник._ДемоПартнеры&id=00000000-0000-0000-0000-000000000000
Authorization: {{$dotenv OBJECTS_AUTH}}

### Неверный идентификатор объекта
# Ожидание: 400, invalid_request, details[0].path=id.
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник._ДемоПартнеры&id=не-uuid
Authorization: {{$dotenv OBJECTS_AUTH}}

### Чтение в неподдерживаемом виде метаданных
# Ожидание: 400, invalid_request, сообщение "Вид метаданных не поддерживается".
GET {{$dotenv OBJECTS_URL}}/object?type=РегистрСведений._ДемоРеестрСкладскихДокументов&id={{$dotenv PARTNER_ID}}
Authorization: {{$dotenv OBJECTS_AUTH}}

### Найти вариант отчёта для чтения хранилища значения
# Ожидание: 200; items[0].id — вариант, который читает запрос ниже. Нужен хотя бы один вариант отчёта.
# @name variantSearch
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник.ВариантыОтчетов&q=а&limit=1
Authorization: {{$dotenv OBJECTS_AUTH}}

### Прочитать хранилище значения
# Ожидание: 200; header.Настройки — JSON null или строка base64.
# Это же чтение даёт образец для создания варианта ниже. Если Настройки здесь null, запрос создания
# варианта с настройками не выполнять: REST Client подставит строку "null", похожую на base64.
# @name variantRead
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник.ВариантыОтчетов&id={{variantSearch.response.body.$.items[0].id}}
Authorization: {{$dotenv OBJECTS_AUTH}}

# ---------------------------------------------------------------------------
# Создание, POST /object. Запросы создания создают объекты в базе: повтор создаёт ещё один.
# Запросы со ссылками на ответы выше (groupA, partnerItem, invoiceA) выполняйте после них, в одном сеансе.
# Тела счёта ниже — пример: поля Дата, ВалютаДокумента, Партнер, Организация, Ответственный,
# Подразделение и в строке Товары Номенклатура, Цена, Сумма, Всего взяты из метаданных, не из ответа сервиса.
# Перед живым прогоном сверить тело с GET /type?name=Документ._ДемоСчетНаОплатуПокупателю:
# в теле должны быть все обязательные поля, доступные для записи. Суммы — литералы, сервис их не считает.
# Открытие созданных объектов в 1С:Предприятии и сравнение списков до и после отказов выполняет пользователь.
# ---------------------------------------------------------------------------

### Создать группу партнёров
# Ожидание: 201; id новый; header.ЭтоГруппа=true; header.Код непустой.
# @name groupA
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоПартнеры","header":{"Наименование":"Контрольная группа партнёров","ЭтоГруппа":true},"tables":{}}

### Повтор создания группы
# Ожидание: 201; id другой, чем у предыдущей группы (повтор не идемпотентен).
# @name groupB
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоПартнеры","header":{"Наименование":"Контрольная группа партнёров","ЭтоГруппа":true},"tables":{}}

### Элемент в созданной группе
# Ожидание: 201; header.Родитель равен id группы groupA; header.ЭтоГруппа=false.
# @name partnerItem
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоПартнеры","header":{"Наименование":"Контрольный партнёр","Родитель":"{{groupA.response.body.$.id}}","ВидПартнера":"ЮридическоеЛицо"},"tables":{}}

### Элемент как родитель
# Ожидание: 400, invalid_request, details[0].path=header.Родитель; текст не говорит, существует ли группа.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоПартнеры","header":{"Наименование":"Партнёр под элементом","Родитель":"{{partnerItem.response.body.$.id}}","ВидПартнера":"ЮридическоеЛицо"},"tables":{}}

### Контактное лицо с владельцем-элементом
# Ожидание: 201; header.Владелец равен id созданного партнёра partnerItem.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоКонтактныеЛицаПартнеров","header":{"Наименование":"Контрольное контактное лицо","Владелец":"{{partnerItem.response.body.$.id}}"},"tables":{}}

### Контактное лицо с владельцем-группой
# Ожидание: 400, invalid_request, details[0].path=header.Владелец.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоКонтактныеЛицаПартнеров","header":{"Наименование":"Контактное лицо группы","Владелец":"{{groupA.response.body.$.id}}"},"tables":{}}

### Договор контрагента с пустым родителем
# Обязательные поля закрыты существующими ссылками из .env: контрагент, организация, партнёр, валюта.
# Ожидание: 201. Если штатная проверка заполнения не даёт создать договор — 422: проверку не отключать,
# остановиться и согласовать границу.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоДоговорыКонтрагентов","header":{"Наименование":"Контрольный договор","Владелец":"{{$dotenv COUNTERPARTY_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Партнер":"{{$dotenv PARTNER_ID}}","ВалютаРасчетов":"{{$dotenv CURRENCY_ID}}","Родитель":null},"tables":{}}

### Договор контрагента, родитель — контрагент
# Родитель договора — другой договор, не контрагент. Ожидание: 400, details[0].path=header.Родитель.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоДоговорыКонтрагентов","header":{"Наименование":"Договор с чужим родителем","Владелец":"{{$dotenv COUNTERPARTY_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Партнер":"{{$dotenv PARTNER_ID}}","ВалютаРасчетов":"{{$dotenv CURRENCY_ID}}","Родитель":"{{$dotenv COUNTERPARTY_ID}}"},"tables":{}}

### Договор контрагента, родитель — группа другого справочника
# Ожидание: 400, details[0].path=header.Родитель.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоДоговорыКонтрагентов","header":{"Наименование":"Договор с группой","Владелец":"{{$dotenv COUNTERPARTY_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Партнер":"{{$dotenv PARTNER_ID}}","ВалютаРасчетов":"{{$dotenv CURRENCY_ID}}","Родитель":"{{groupA.response.body.$.id}}"},"tables":{}}

### Создать непроведённый счёт
# Ожидание: 201; header.Проведен=false; header.Номер назначен; id читается GET /object ниже.
# @name invoiceA
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Документ._ДемоСчетНаОплатуПокупателю","header":{"Дата":"2026-10-27T10:00:00","ВалютаДокумента":"{{$dotenv CURRENCY_ID}}","Партнер":"{{$dotenv PARTNER_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Ответственный":"{{$dotenv RESPONSIBLE_ID}}","Подразделение":"{{$dotenv DEPARTMENT_ID}}"},"tables":{"Товары":[{"Номенклатура":"{{$dotenv PRODUCT_ID}}","Количество":2,"Цена":100,"Сумма":200,"Всего":200}]}}

### Прочитать созданный счёт
# Ожидание: 200; тот же id, header.Проведен=false.
GET {{$dotenv OBJECTS_URL}}/object?type=Документ._ДемоСчетНаОплатуПокупателю&id={{invoiceA.response.body.$.id}}
Authorization: {{$dotenv OBJECTS_AUTH}}

### Тот же счёт вторым POST
# Ожидание: 201; id другой, чем у invoiceA.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Документ._ДемоСчетНаОплатуПокупателю","header":{"Дата":"2026-10-27T10:00:00","ВалютаДокумента":"{{$dotenv CURRENCY_ID}}","Партнер":"{{$dotenv PARTNER_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Ответственный":"{{$dotenv RESPONSIBLE_ID}}","Подразделение":"{{$dotenv DEPARTMENT_ID}}"},"tables":{"Товары":[{"Номенклатура":"{{$dotenv PRODUCT_ID}}","Количество":2,"Цена":100,"Сумма":200,"Всего":200}]}}

### Счёт без даты
# Ожидание: 400, details[0].path=header.Дата, сообщение "Дата обязательна".
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Документ._ДемоСчетНаОплатуПокупателю","header":{"ВалютаДокумента":"{{$dotenv CURRENCY_ID}}","Партнер":"{{$dotenv PARTNER_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Ответственный":"{{$dotenv RESPONSIBLE_ID}}","Подразделение":"{{$dotenv DEPARTMENT_ID}}"},"tables":{"Товары":[{"Номенклатура":"{{$dotenv PRODUCT_ID}}","Количество":2,"Цена":100,"Сумма":200,"Всего":200}]}}

### Счёт с датой в UTC
# Ожидание: 400, details[0].path=header.Дата.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Документ._ДемоСчетНаОплатуПокупателю","header":{"Дата":"2026-10-27T10:00:00Z","ВалютаДокумента":"{{$dotenv CURRENCY_ID}}","Партнер":"{{$dotenv PARTNER_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Ответственный":"{{$dotenv RESPONSIBLE_ID}}","Подразделение":"{{$dotenv DEPARTMENT_ID}}"},"tables":{"Товары":[{"Номенклатура":"{{$dotenv PRODUCT_ID}}","Количество":2,"Цена":100,"Сумма":200,"Всего":200}]}}

### Счёт с полем Номер
# Ожидание: 400, details[0].path=header.Номер (поле назначает 1С).
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Документ._ДемоСчетНаОплатуПокупателю","header":{"Номер":"123","Дата":"2026-10-27T10:00:00","ВалютаДокумента":"{{$dotenv CURRENCY_ID}}","Партнер":"{{$dotenv PARTNER_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Ответственный":"{{$dotenv RESPONSIBLE_ID}}","Подразделение":"{{$dotenv DEPARTMENT_ID}}"},"tables":{"Товары":[{"Номенклатура":"{{$dotenv PRODUCT_ID}}","Количество":2,"Цена":100,"Сумма":200,"Всего":200}]}}

### Счёт со ссылкой на группу в ссылочном поле
# Ожидание: 400, details[0].path=header.Партнер; текст — общий текст недопустимого значения или ссылки.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Документ._ДемоСчетНаОплатуПокупателю","header":{"Дата":"2026-10-27T10:00:00","ВалютаДокумента":"{{$dotenv CURRENCY_ID}}","Партнер":"{{groupA.response.body.$.id}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Ответственный":"{{$dotenv RESPONSIBLE_ID}}","Подразделение":"{{$dotenv DEPARTMENT_ID}}"},"tables":{"Товары":[{"Номенклатура":"{{$dotenv PRODUCT_ID}}","Количество":2,"Цена":100,"Сумма":200,"Всего":200}]}}

### Счёт без обязательного поля шапки
# Ожидание: 422, validation_failed, details не пуст; документ не создаётся.
# Что документ не остался, подтверждает пользователь списком документов до и после.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Документ._ДемоСчетНаОплатуПокупателю","header":{"Дата":"2026-10-27T10:00:00","ВалютаДокумента":"{{$dotenv CURRENCY_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Ответственный":"{{$dotenv RESPONSIBLE_ID}}","Подразделение":"{{$dotenv DEPARTMENT_ID}}"},"tables":{"Товары":[{"Номенклатура":"{{$dotenv PRODUCT_ID}}","Количество":2,"Цена":100,"Сумма":200,"Всего":200}]}}

### Счёт без обязательного поля строки
# Ожидание: 422, validation_failed, details не пуст (в строке нет Цены).
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Документ._ДемоСчетНаОплатуПокупателю","header":{"Дата":"2026-10-27T10:00:00","ВалютаДокумента":"{{$dotenv CURRENCY_ID}}","Партнер":"{{$dotenv PARTNER_ID}}","Организация":"{{$dotenv ORGANIZATION_ID}}","Ответственный":"{{$dotenv RESPONSIBLE_ID}}","Подразделение":"{{$dotenv DEPARTMENT_ID}}"},"tables":{"Товары":[{"Номенклатура":"{{$dotenv PRODUCT_ID}}","Количество":2,"Сумма":200,"Всего":200}]}}

### Чтение по выдуманному id после отказа
# Ожидание: 404, not_found для нулевого UUID. Запрос проверяет только 404 и откат не доказывает:
# что отказы 422 не оставили документов, подтверждает список документов пользователя.
GET {{$dotenv OBJECTS_URL}}/object?type=Документ._ДемоСчетНаОплатуПокупателю&id=00000000-0000-0000-0000-000000000000
Authorization: {{$dotenv OBJECTS_AUTH}}

### Партнёр с полем Код
# Ожидание: 400, details[0].path=header.Код, причина — код назначает 1С.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоПартнеры","header":{"Наименование":"Партнёр с кодом","Код":"000000001","ВидПартнера":"ЮридическоеЛицо"},"tables":{}}

### Партнёр с ДополнительныеРеквизиты
# Ожидание: 400, details[0].path=tables.ДополнительныеРеквизиты.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоПартнеры","header":{"Наименование":"Партнёр с свойствами","ВидПартнера":"ЮридическоеЛицо"},"tables":{"ДополнительныеРеквизиты":[]}}

### Организация с ЭтоГруппа
