POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоПартнеры","header":{"Наименование":"Партнёр","НетТакогоПоля":1},"tables":{}}

### Хвост после JSON
# Ожидание: 400, invalid_request: после значения тела есть лишние данные.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник._ДемоПартнеры","header":{},"tables":{}} {}

### Неверный тип тела
# Ожидание: 415, unsupported_media_type.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: text/plain

{"type":"Справочник._ДемоПартнеры","header":{},"tables":{}}

### Создание в неподдерживаемом виде метаданных
# Ожидание: 400, invalid_request, "Вид метаданных не поддерживается".
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"РегистрСведений._ДемоРеестрСкладскихДокументов","header":{},"tables":{}}

### Хранилище значения: строка не base64
# Ожидание: 400 до записи, details[0].path=header.Настройки.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник.ВариантыОтчетов","header":{"Наименование":"Контрольный вариант","Настройки":"%%%"},"tables":{}}

### Вариант отчёта с хранилищем из существующего варианта
# Не выполнялся. Обязательные поля варианта (Автор, Отчет, ТипОтчета, Назначение) берутся из образца.
# Требуется variantRead.response.body.header.Настройки — непустая строка base64, не null:
# null REST Client подставит как строку "null", и запрос запишет испорченное хранилище.
# Если у образца Настройки равны null, этот запрос не выполнять; выбрать другой вариант в поиске выше.
# Ожидание: 201 и тот же header.Настройки при следующем GET. Если штатная проверка заполнения
# не даёт создать вариант (422) — остановиться и согласовать границу, проверку не обходить.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник.ВариантыОтчетов","header":{"Наименование":"Контрольный вариант с настройками","Автор":"{{variantRead.response.body.$.header.Автор}}","Отчет":{{variantRead.response.body.$.header.Отчет}},"ТипОтчета":"{{variantRead.response.body.$.header.ТипОтчета}}","Назначение":"{{variantRead.response.body.$.header.Назначение}}","Настройки":"{{variantRead.response.body.$.header.Настройки}}"},"tables":{}}

### Полномочие доверенности с идентификатором не UUID
# Ожидание: 400 до записи, details[0].path=tables.Полномочия[0].ИдентификаторПолномочия.
# Каноническая строка 00000000-0000-0000-0000-000000000000 для этого поля допустима как значение;
# доверенность целиком не создаётся: её остальные обязательные поля в этом файле не закрыты.
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{"type":"Справочник.МашиночитаемыеДоверенности","header":{},"tables":{"Полномочия":[{"ИдентификаторПолномочия":"не-uuid"}]}}
